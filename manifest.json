{
  "id": "org.custom.movielair",
  "name": "MovieLair Alternative Player",
  "version": "1.1.0",
  "description": "Renders custom playback frames inside Nuvio.",
  "icon": "https://movielair.cc",
  "type": "provider",
  "content": {
    "trusted": true,
    "actions": {
      "movie": "https://vidsrc.xyz{id}",
      "series": "https://vidsrc.xyz{id}&season={season}&episode={episode}"
    }
  }
}
